GROQ_API_KEY=your_groq_key_here
GOOGLE_API_KEY=your_gemini_key_here

# Set to offline to skip downloading the embedding model
EMBEDDINGS=

# Self-hosted Qwen 2.5 14B (OpenAI-compatible llama.cpp server via SSH tunnel). Default provider.
# The key itself is NOT stored here: it is read from the QWEN_API_KEY environment variable.
LLM_PROVIDER=Qwen
LLM_BASE_URL=http://127.0.0.1:18205/v1
LLM_MODEL=qwen2.5-14b
LLM_API_KEY_ENV=QWEN_API_KEY
LLM_TIMEOUT=600
LLM_MAX_TOKENS=1500
